# SANGAM Backend Configuration
# Copy to .env for local overrides (setup scripts do this automatically).

# Default: SQLite (zero-setup). File is created under backend/ when the API starts.
DATABASE_URL=sqlite:///./sangam.db

# Optional PostgreSQL (PostGIS NOT required for this prototype):
# DATABASE_URL=postgresql://sangam:sangam@localhost:5432/sangam

DATA_MODE=prototype
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed to call the API with credentials.
# Do not set to * with credentialed cookies/auth headers in development.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Optional: LLM generation over retrieved RAG context only
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
