# SANGAM Backend Configuration
# Default: SQLite (no setup required for demo)
DATABASE_URL=sqlite:///./sangam.db

# Optional PostgreSQL:
# DATABASE_URL=postgresql://sangam:sangam@localhost:5432/sangam

DATA_MODE=prototype
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Optional: enable LLM generation over retrieved RAG context
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
